# Explicit loading only: uv run --env-file .env.local ...
DEEPHELP_MODE=dev
DEEPHELP_MODEL_API_KEY=
DEEPHELP_MODEL_BASE_URL=
DEEPHELP_ENABLE_LIVE=false
DEEPHELP_REQUEST_TIMEOUT=5
DEEPHELP_CHILD_TIMEOUT=1
DEEPHELP_HTTP_CONNECTIONS=10
DEEPHELP_LLM_CONCURRENCY=2
DEEPHELP_MAX_ATTEMPTS=3
DEEPHELP_RETRY_LIMIT=1
DEEPHELP_TRACE_PATH=logs/m01-trace.jsonl
# Business converse remains a skeleton. Real M03 probe requires explicit CLI budgets.
DEEPHELP_LIVE_MODEL=
DEEPHELP_LIVE_MAX_CALLS=0
DEEPHELP_LIVE_MAX_TOKENS=0
DEEPHELP_LIVE_MAX_COST=0
# Provider profiles may point embedding at separate credentials without changing chat.
# DEEPHELP_EMBEDDING_BASE_URL=
# DEEPHELP_EMBEDDING_API_KEY=

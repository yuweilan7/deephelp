DEEPHELP_RUNTIME_ROOT=/srv/deephelp-modern
DEEPHELP_STATE_ROOT=/srv/deephelp-modern/state
DEEPHELP_SECRET_FILE=/srv/deephelp-modern/config/middleware.env
DEEPHELP_ARTIFACT_MAP=/srv/deephelp-modern/config/artifact-map.json
DEEPHELP_POSTGRES_CONFIG=/srv/deephelp-modern/config/postgres.json
DEEPHELP_LANGFUSE_CONFIG=/srv/deephelp-modern/config/langfuse.json
DEEPHELP_CORPUS=<ABSOLUTE_PUBLISHED_CORPUS_PATH>
DEEPHELP_RELEASE_CHANNEL=<PERSONAL_RELEASE_CHANNEL>
DEEPHELP_MODEL_BASE_URL=<EXISTING_HTTPS_MODEL_ENDPOINT>
DEEPHELP_MODEL_API_KEY=<DELIVER_SEPARATELY>
DEEPHELP_GRAFANA_URL=http://127.0.0.1:23000
DEEPHELP_LEARNING_CATALOG=/srv/deephelp-modern/config/learning-catalog.json
DEEPHELP_LEARNING_RIGHTS_PORT=8015
DEEPHELP_LEARNING_RIGHTS_KEY=/srv/deephelp-modern/state/rights.key
DEEPHELP_APP_METRICS_PORT=9464
DEEPHELP_BUSINESS_METRICS_PORT=9465
DEEPHELP_RETRIEVAL_METRICS_PORT=9466
# Optional separately retained M29 learning/history database:
# DEEPHELP_LEARNING_DATABASE=<EXPLICIT_DATABASE_NAME>
# First rehearsal uses separate ports and no accepted channel:
# DEEPHELP_ISOLATED_REHEARSAL=1
# DEEPHELP_APP_PORT=8100
# DEEPHELP_BUSINESS_PORT=8111
# DEEPHELP_RETRIEVAL_PORT=8112

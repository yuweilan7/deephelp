[Unit]
Description=DeepHelp personal %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
EnvironmentFile=/srv/deephelp-personal/config/runtime.env
ExecStart=/opt/deephelp-app/current/start.sh %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

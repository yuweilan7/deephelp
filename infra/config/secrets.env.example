# Copy to ~/.deephelp/.env.secret or point DEEPHELP_SECRET_FILE to an ignored local file.
# These values must match the existing remote service accounts. Do not generate new passwords here.
MYSQL_ROOT_PASSWORD=<FILL_FROM_SECRET>
MYSQL_PASSWORD=<FILL_FROM_SECRET>
REDIS_PASSWORD=<FILL_FROM_SECRET>
REDIS_ADMIN_PASSWORD=<FILL_FROM_SECRET>
MILVUS_ROOT_PASSWORD=<FILL_FROM_SECRET>
MILVUS_PASSWORD=<FILL_FROM_SECRET>
MILVUS_BOOTSTRAP_PASSWORD=<FILL_FROM_SECRET>
